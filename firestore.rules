rules_version = '2';

// Reglas de seguridad de Cloud Firestore — Conecta Digital Móvil.
//
// La app de la Etapa 3 no usa Firebase Auth: el rol se elige en la pantalla de
// acceso y se guarda en el dispositivo. Por eso el acceso a "solicitudes" es
// anónimo, pero se acota de forma explícita en lugar de abrir todo el proyecto:
//
//   - Solo la colección "solicitudes" es accesible; el resto queda denegado.
//   - El acceso caduca el 2026-12-31 (igual que el "modo de prueba" de Firebase).
//
// Endurecer esto requiere Firebase Auth por rol, señalado como trabajo futuro.
service cloud.firestore {
  match /databases/{database}/documents {

    match /solicitudes/{solicitudId} {
      allow read, write: if request.time < timestamp.date(2026, 12, 31);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
